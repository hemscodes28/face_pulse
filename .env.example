# ============================================================
# Face Pulse — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# -----------------------------------------------------------
# DATABASE
# -----------------------------------------------------------

# Async URL used by the FastAPI application (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/face_pulse

# Sync URL used by Alembic migrations only (psycopg2 driver)
DATABASE_URL_SYNC=postgresql+psycopg2://username:password@localhost:5432/face_pulse

# Test database URL (SQLite in-memory for CI; swap to real PG for integration tests)
TEST_DATABASE_URL=sqlite+aiosqlite:///./test.db

# -----------------------------------------------------------
# POSTGRESQL (used by docker-compose)
# -----------------------------------------------------------
POSTGRES_USER=face_pulse_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=face_pulse
POSTGRES_PORT=5432
